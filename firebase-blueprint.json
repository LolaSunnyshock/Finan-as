{
  "entities": {
    "Space": {
      "title": "Space",
      "description": "Shared workspace ledger for multi-device finances and notes",
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "description": "Name of the shared space"
        },
        "inviteCode": {
          "type": "string",
          "description": "6-character alphanumeric invite code"
        },
        "ownerId": {
          "type": "string",
          "description": "UID of the space creator"
        },
        "memberUids": {
          "type": "array",
          "description": "List of user UIDs who are members of this space"
        },
        "memberNames": {
          "type": "array",
          "description": "List of user display names in this space"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via serverTimestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp via serverTimestamp"
        }
      },
      "required": ["name", "inviteCode", "ownerId", "memberUids", "memberNames", "createdAt", "updatedAt"]
    },
    "Transaction": {
      "title": "Transaction",
      "description": "Financial income or expense transaction item",
      "type": "object",
      "properties": {
        "spaceId": {
          "type": "string",
          "description": "Parent space identifier"
        },
        "userId": {
          "type": "string",
          "description": "User identifier who recorded this transaction"
        },
        "userName": {
          "type": "string",
          "description": "Display name of the author"
        },
        "description": {
          "type": "string",
          "description": "Description of the transaction"
        },
        "amount": {
          "type": "number",
          "description": "Transaction value in monetary units"
        },
        "type": {
          "type": "string",
          "description": "Transaction type",
          "enum": ["INCOME", "EXPENSE"]
        },
        "category": {
          "type": "string",
          "description": "Category of the transaction"
        },
        "date": {
          "type": "string",
          "description": "Date formatted as YYYY-MM-DD"
        },
        "isFixed": {
          "type": "boolean",
          "description": "Whether this transaction repeats monthly as a fixed bill"
        },
        "fixedEndMonth": {
          "type": "string",
          "description": "Optional inclusive end month YYYY-MM for fixed bills"
        },
        "installmentGroupId": {
          "type": "string",
          "description": "Shared group ID linking installments across months"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via serverTimestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp via serverTimestamp"
        }
      },
      "required": ["spaceId", "userId", "userName", "description", "amount", "type", "category", "date", "createdAt", "updatedAt"]
    },
    "Note": {
      "title": "Note",
      "description": "Shared note document for quick thoughts and notes",
      "type": "object",
      "properties": {
        "spaceId": {
          "type": "string",
          "description": "Parent space identifier"
        },
        "userId": {
          "type": "string",
          "description": "User identifier who created the note"
        },
        "authorName": {
          "type": "string",
          "description": "Display name of the note author"
        },
        "title": {
          "type": "string",
          "description": "Title of the note"
        },
        "content": {
          "type": "string",
          "description": "Body text of the note"
        },
        "color": {
          "type": "string",
          "description": "Optional accent color tag"
        },
        "isPinned": {
          "type": "boolean",
          "description": "Whether the note is pinned to top"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Creation timestamp via serverTimestamp"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp via serverTimestamp"
        }
      },
      "required": ["spaceId", "userId", "authorName", "title", "content", "createdAt", "updatedAt"]
    },
    "UserProfile": {
      "title": "UserProfile",
      "description": "User preferences and active space binding",
      "type": "object",
      "properties": {
        "userId": {
          "type": "string",
          "description": "User UID"
        },
        "activeSpaceId": {
          "type": "string",
          "description": "Currently active space ID"
        },
        "email": {
          "type": "string",
          "description": "User email"
        },
        "displayName": {
          "type": "string",
          "description": "User display name"
        },
        "updatedAt": {
          "type": "string",
          "format": "date-time",
          "description": "Update timestamp"
        }
      },
      "required": ["userId", "activeSpaceId", "email"]
    }
  },
  "firestore": {
    "/spaces/{spaceId}": {
      "schema": {
        "$ref": "#/entities/Space"
      },
      "description": "Shared spaces collection"
    },
    "/spaces/{spaceId}/transactions/{transactionId}": {
      "schema": {
        "$ref": "#/entities/Transaction"
      },
      "description": "Transactions in shared space"
    },
    "/spaces/{spaceId}/notes/{noteId}": {
      "schema": {
        "$ref": "#/entities/Note"
      },
      "description": "Notes in shared space"
    },
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile with active space pointer"
    }
  }
}
